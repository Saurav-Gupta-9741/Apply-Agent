{
  "name": "applyagent",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that fills job applications on company career sites, with proof of every submission",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run test/automation-eval.test.ts",
    "e2e": "playwright test --grep-invert \"live read-only\"",
    "e2e:live": "node -e \"process.env.LIVE=1;require('child_process').execSync('npx playwright test e2e/live-scan.spec.ts',{stdio:'inherit',env:process.env})\"",
    "test:all": "npm run typecheck && npm test && npm run e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1"
  }
}
